DATABASE_URL="postgresql://user:password@localhost:5432/woodshop_product?schema=public"
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000

# Required in production. Generate unique values with a password manager.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_COOKIE_SECRET=
ADMIN_API_KEY=
# Set true only for a private, temporary troubleshooting window.
ENABLE_SWAGGER=false

# S3 configurations
ACCESS_KEY=
SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
REGION_NAME=
