{
  "name": "woodshop",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "format": "prettier --write \"**/*.ts\"",
    "clean": "pnpm -r exec rm -rf dist"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@types/node": "^20.0.0",
    "prisma": "^5.0.0",
    "typescript": "^5.3.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=8"
  },
  "packageManager": "pnpm@10.19.0",
  "pnpm": {
    "overrides": {
      "axios": "1.18.0",
      "brace-expansion": "1.1.17",
      "js-yaml": "4.3.0",
      "lodash": "4.18.1",
      "multer": "2.2.0",
      "postcss": "8.5.18",
      "sharp": "0.35.0",
      "serialize-javascript": "7.0.3",
      "tinymce": "7.9.3"
    }
  }
}
